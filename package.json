{
  "name": "lightway-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prebuild": "pnpm codegen",
    "pretest": "pnpm codegen",
    "codegen": "graphql-codegen --config codegen.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs src",
    "schema:sync": "node scripts/sync-schema.mjs",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,scss,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@apollo/client": "^4.3.8",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@jsverse/transloco": "^8.4.0",
    "graphql": "^17.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.20.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "angular-eslint": "^22.8.0",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.0"
  }
}
